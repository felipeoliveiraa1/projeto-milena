NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Lembretes no celular (notificações) — ver docs/setup-lembretes.md.
# Os valores de verdade ficam só no .env.local e na Vercel, nunca aqui.
# Chaves VAPID: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# https://... do app ou mailto:seu-email (sem isso, usa o endereço do app na Vercel)
VAPID_SUBJECT=
# Senha que o pg_cron do Supabase manda para /api/lembretes (a mesma do Vault)
CRON_SECRET=
# Chave secreta do Supabase (Settings → API Keys: secret, ou a service_role).
# Só no servidor: nunca com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
